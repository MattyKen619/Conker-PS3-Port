@@ -83,6 +83,31 @@ static inline void DDIVU(uint64_t a, uint64_t b, uint64_t* quot, uint64_t* rem)
 
 typedef uint64_t gpr;
 
+// Byte order of the host. N64 RDRAM is big-endian. Little-endian hosts store it as native 32-bit
+// words, so byte and halfword addresses are XORed to find the right byte within a word. A
+// big-endian host (PS3) stores RDRAM exactly as the N64 does, so no XOR is needed.
+#if defined(__BIG_ENDIAN__) || (defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__)
+    #define RECOMP_BIG_ENDIAN 1
+    #define RECOMP_HALF_XOR 0
+    #define RECOMP_BYTE_XOR 0
+#else
+    #define RECOMP_BIG_ENDIAN 0
+    #define RECOMP_HALF_XOR 2
+    #define RECOMP_BYTE_XOR 3
+#endif
+
+// Offset into the host's RDRAM block of an N64 virtual address (sign-extended to 64 bits).
+// Default: KSEG0 maps to offset 0 (the block is part of a 4GB reservation, so other addresses
+// land in the reservation). PS3: no 4GB reservation is possible, so addresses are masked to 26 bits
+// instead (free on the PPU: one rotate-and-mask replaces the add). KSEG0 and KSEG1 both map to
+// offset 0, and the TLB-mapped segments at 0x15000000 / 0x16000000 land at 16MB / 32MB.
+#if defined(__lv2ppu__)
+    #define RECOMP_MEM_MASK 0x03FFFFFFu
+    #define RECOMP_OFFSET(addr) ((uint32_t)(addr) & RECOMP_MEM_MASK)
+#else
+    #define RECOMP_OFFSET(addr) ((addr) - 0xFFFFFFFF80000000)
+#endif
+
 #define SIGNED(val) \
     ((int64_t)(val))
 
