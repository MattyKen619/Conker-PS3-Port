+#if defined(__lv2ppu__)
+#include <cstdio>
+#include <cerrno>
+#include <cstring>
+#include <sys/file.h>
+// PS3: files earlier versions made with std::filesystem::copy_file could come out with no permission
+// bits (unreadable, unwritable: saving failed from then on). Every file the saving touches is made
+// readable and writable first.
+static void ps3_make_rw(const std::filesystem::path& p) {
+    sysFSStat st;
+    if (sysLv2FsStat(p.string().c_str(), &st) == 0 && (st.st_mode & 0600) != 0600) {
+        std::printf("[save] %s had mode %o: making it readable and writable\n", p.string().c_str(), (unsigned)st.st_mode);
+        sysLv2FsChmod(p.string().c_str(), (st.st_mode & ~0777) | 0666);
+    }
+}
+#endif
+
 std::ofstream recomp::open_output_file_with_backup(const std::filesystem::path& filepath, std::ios_base::openmode mode) {
     std::filesystem::path temp_path{filepath};
     temp_path += temp_suffix;
+#if defined(__lv2ppu__)
+    ps3_make_rw(temp_path);
+    ps3_make_rw(filepath);
+    std::ofstream temp_file_out{ temp_path, mode };
+    if (!temp_file_out.good()) std::printf("[save] can't create %s: %s\n", temp_path.string().c_str(), std::strerror(errno));
+    return temp_file_out;
+#else
     std::ofstream temp_file_out{ temp_path, mode };
 
     return temp_file_out;
+#endif
+}
+
+#if defined(__lv2ppu__)
+// PS3: std::filesystem::copy_file fails on the console's file system (the save never landed), so the
+// copies are done by reading and writing, and each failure is logged.
+static bool ps3_copy_file(const std::filesystem::path& from, const std::filesystem::path& to) {
+    ps3_make_rw(from);
+    ps3_make_rw(to);
+    std::FILE* in = std::fopen(from.string().c_str(), "rb");
+    if (!in) { std::printf("[save] can't open %s: %s\n", from.string().c_str(), std::strerror(errno)); return false; }
+    std::FILE* out = std::fopen(to.string().c_str(), "wb");
+    if (!out) { std::printf("[save] can't create %s: %s\n", to.string().c_str(), std::strerror(errno)); std::fclose(in); return false; }
+    char buf[16384];
+    bool ok = true;
+    for (size_t n; (n = std::fread(buf, 1, sizeof buf, in)) > 0;)
+        if (std::fwrite(buf, 1, n, out) != n) { ok = false; break; }
+    if (std::ferror(in)) ok = false;
+    std::fclose(in);
+    if (std::fclose(out) != 0) ok = false;
+    if (!ok) std::printf("[save] copying %s to %s failed: %s\n", from.string().c_str(), to.string().c_str(), std::strerror(errno));
+    return ok;
 }
 
+bool recomp::finalize_output_file_with_backup(const std::filesystem::path& filepath) {
+    std::filesystem::path backup_path{filepath};
+    backup_path += backup_suffix;
+    std::filesystem::path temp_path{filepath};
+    temp_path += temp_suffix;
+    std::error_code ec;
+    if (std::filesystem::exists(filepath, ec) && !ps3_copy_file(filepath, backup_path)) return false;
+    if (!ps3_copy_file(temp_path, filepath)) return false;
+    std::filesystem::remove(temp_path, ec);
+    return true;
+}
